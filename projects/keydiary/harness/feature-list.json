          "time_bucket": "5 分钟粒度（对齐到 0/5/10/.../55 分）",
          "flush_trigger": "每 60 秒或 buffer 达到 1000 条",
          "flush_sql": "INSERT ... ON CONFLICT(date, time_bucket, key_code) DO UPDATE SET count = count + excluded.count",
          "thread_safety": "Arc<Mutex<Aggregator>>",
          "failure_handling": "flush 失败保留 buffer 数据下次重试",
          "shutdown": "退出前执行最终 flush（不丢数据）"
